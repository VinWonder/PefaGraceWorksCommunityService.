# Copy this file to .env and fill in your values:   cp .env.example .env
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_URL=admin/

# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://pgcs_user:pgcs_password@localhost:5432/pgcs_db

# Email (console prints emails in the terminal while developing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=info@pefagraceworks.org
# EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=PEFA GraceWorks <info@pefagraceworks.org>
STAFF_NOTIFICATION_EMAILS=info@pefagraceworks.org

# M-Pesa Daraja (https://developer.safaricom.co.ke)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-ngrok-or-domain/donate/mpesa/callback/
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Optional
# REDIS_URL=redis://localhost:6379/0

# PayPal Checkout: PayPal + debit/credit cards (https://developer.paypal.com → Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal does not settle in KES; card/PayPal gifts are taken in USD and converted at this rate for project totals
PAYPAL_KES_PER_USD=129
